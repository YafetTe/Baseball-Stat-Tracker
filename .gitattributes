import pandas as pd


""This class is used to determine a single-player's statistics."""

class BaseballPlayer:

    def __init__(self, name, at_bats, hits, home_runs, doubles, triples, walks, hbp, sac_flys):
        self.name = name
        self.at_bats = int(at_bats)
        self.hits = int(hits)
        self.home_runs = int(home_runs)
        self.doubles = int(doubles)
        self.triples = int(triples)
        self.walks = int(walks)
        self.hbp = int(hbp)
        self.sac_flys = int(sac_flys)

    def calculate_batting_avg(self):
"""
This function calculates batting average, which is a stat that determines how many times a hitter gets a hit per at bat. This will be an important stat for
batters near the middle of the lineup because hits are more likely to drive in runs than walks are.

args:
at bats:  an integer to represent the amount of plate apearances where the batter gets out or puts the ball in play
hits: an integer to represent the amount of times where the ball was put in play and the batter reached base safely

returns: a float between 0 and 1 inclusive that demonstrates the amount of times per at bat a batter puts the ball in play and reaches base safely.
"""
        if self.at_bats == 0:
            return 0.0
        return round(self.hits / self.at_bats, 3)

    def calculate_slugging(self):
"""
slugging percentage is similar to batting average but it factors in whether a hit was a single, a double, a triple, or a home run. This is useful because bigger
hits are more valuable to the team. This will be an important stat for batters near the middle of the lineup as a higher slugging percentage is better for driving
more runners in.

args:
at bats:  an integer to represent the amount of plate apearances where the batter gets out or puts the ball in play
hits: an integer to represent the amount of times where the ball was put in play and the batter reached base safely
doubles: an integer to represent the amount of times where the ball was put in play and the batter reached second base safely
triples: an integer to represent the amount of times where the ball was put in play and the batter reached third base safely
home runs: an integer to represent the amount of times where the ball was put in play and the batter reached home plate safely

returns: a float between 0 and 4 inclusive that represents how many bases a batter is able to reach per plate appearance.
"""
        if self.at_bats <= 0:
            return 0.0
        singles = self.hits - self.doubles - self.triples - self.home_runs
        total_bases = (
            singles +
            (self.doubles * 2) +
            (self.triples * 3) +
            (self.home_runs * 4)
        )
        return round(total_bases / self.at_bats, 3)

    #calculate obp  (ON BASE PERCENTAGE -  How many times a player can get on base per plate appearance)
    def calculate_obp(self):
"""
on base percentage shows how often a batter gets on base per plate appearance, this includes walks and hit by pitches. This will be an important stat for batters 
at the front of the lineup because they will be able to be scored by the batters in the middle of the lineup.

args:
at bats:  an integer to represent the amount of plate apearances where the batter gets out or puts the ball in play
hits: an integer to represent the amount of times where the ball was put in play and the batter reached base safely
walks: an integer that represent how many times a batter was walked (intentionally and unintentionally) which results in them being awarded first base
hbp: an integer that represents how many times a batter was hit by a pitch, which functions the same as a walk

returns: a float between 0 and 1 inclusive which represents how many times a runner reaches base per at bat
"""
        if self.at_bats <= 0:
            return 0.0
        obp = (self.hits + self.hbp + self.walks)/self.at_bats
        return round(obp, 3)

    #calculate woba  
    def calculate_woba(self):
"""
woba stands for weighted on base average and is calculated by taking every possible outcome from a plate appearance and determining how many runs are scored per
inning that outcome occurs in. This is very useful because it factors in every outcome as well as how much value the batter achieving that outcome adds. This will
be important for all batters throughout the lineup.

args:
at bats:  an integer to represent the amount of plate appearances where the batter gets out or puts the ball in play
hits: an integer to represent the amount of times where the ball was put in play and the batter reached base safely
walks: an integer that represent how many times a batter was walked (intentionally and unintentionally) which results in them being awarded first base
hbp: an integer that represents how many times a batter was hit by a pitch, which functions the same as a walk
doubles: an integer to represent the amount of times where the ball was put in play and the batter reached second base safely
triples: an integer to represent the amount of times where the ball was put in play and the batter reached third base safely
home runs: an integer to represent the amount of times where the ball was put in play and the batter reached home plate safely
sac flys: an integer that represents the amount of times a batter hit a ball that was caught but a run was still scored during the play (in baseball if a ball
is caught, the base runners are still allowed to advance as long as they touch the base they started at before the ball is caught

returns: a float between 0 and 2.1 that represents the amount of runs scored per inning added per plate appearance
"""
        if self.at_bats <= 0:
            return 0.0
        self.singles = self.hits - self.doubles - self.triples - self.home_runs
        woba = ((self.walk * 0.69) + (self.hpb * 0.69) + (self.singles * 0.89) + (self.doubles * 1.27) + (self.triples * 1.62) + (self.home_runs * 2.10))/(self.at_bats + self.walks +self.hbp)
        return round(woba, 3)

#This is where we create the function to load in the players from the sample data file
def load_players(filepath):
    df = pd.read_html(filepath)[0]
    df = df.dropna(subset=["Player"])
    players = []
    for _, row in df.iterrows():
        try:
            player = BaseballPlayer(
                name=row["Player"],
                at_bats=row.get("AB", 0),
                hits=row.get("H", 0),
                home_runs=row.get("HR", 0),
                doubles=row.get("2B", 0),
                triples=row.get("3B", 0),
                walks=row.get("BB", 0),
                hbp=row.get("HBP", 0),
                sac_flys=row.get("SF", 0),
            )
            players.append(player)
        except (ValueError, TypeError):
            continue  # skip malformed rows (e.g. totals/headers)
    return players


  # This is where we create the function to display the stats of the individual players
def display_stats(players):
    header = f"{'Player':<22} {'AVG':>6} {'OBP':>6} {'SLG':>6} {'wOBA':>6}"
    print(header)
    print("-" * len(header))
    for p in players:
        print(
            f"{p.name:<22} "
            f"{p.calculate_batting_avg():>6.3f} "
            f"{p.calculate_obp():>6.3f} "
            f"{p.calculate_slugging():>6.3f} "
            f"{p.calculate_woba():>6.3f}"
        )

# This creates the function to look up a specific player's name
def find_player(players, name):
    name_lower = name.lower()
    matches = [p for p in players if name_lower in p.name.lower()]
    return matches

# This creates a function to pull up an in-depth look at a specific player's stats
def display_single_player(player):
    print(f"\n--- {player.name} ---")
    print(f"  At Bats:       {player.at_bats}")
    print(f"  Hits:          {player.hits}")
    print(f"  Home Runs:     {player.home_runs}")
    print(f"  Doubles:       {player.doubles}")
    print(f"  Triples:       {player.triples}")
    print(f"  Walks:         {player.walks}")
    print(f"  HBP:           {player.hbp}")
    print(f"  Sac Flys:      {player.sac_flys}")
    print(f"  Batting Avg:   {player.calculate_batting_avg():.3f}")
    print(f"  OBP:           {player.calculate_obp():.3f}")
    print(f"  Slugging:      {player.calculate_slugging():.3f}")
    print(f"  wOBA:          {player.calculate_woba():.3f}")
 
